#include "test.hpp"
#include <polyfloat/polyfloat.hpp>

template<typename aT> auto mk(auto mval, aT)
{
  mpfr::mpreal::set_default_prec(200);
  return tts::to_polyfloat(mval, aT());
} ;

template<typename T> void print(T a)
{
  constexpr auto dim = plf::dimension_v<T>;
  using u_t = plf::as_component_type_t<T>;
  if constexpr(dim == 1)
  {
    if constexpr(std::same_as<T, float>)
      std::cout << "float(" << std::hexfloat << a << ");" << std::endl;
    else
      std::cout << "double(" << std::hexfloat << a << ");" << std::endl;
  }
  else if constexpr(dim == 2)
  {
    if constexpr(std::same_as<u_t, float>)
      std::cout << "plf::_::from_pair<float>(" << std::hexfloat << plf::hi(a) << ",  " << plf::lo(a)  << ");" << std::endl;
    else
      std::cout << "plf::_::from_pair<double>(" << std::hexfloat << plf::hi(a) << ",  " << plf::lo(a) << ");" << std::endl;
  }
  else if constexpr(dim == 3)
  {
    if constexpr(std::same_as<u_t, float>)
      std::cout << "plf::_::from_triple<float>(" << std::hexfloat << plf::hi(a) << ",  " << plf::md(a)<< ",  " << plf::lo(a)  << ");" << std::endl;
    else
      std::cout << "plf::_::from_triple<double>(" << std::hexfloat << plf::hi(a) << ",  " << plf::md(a)<< ",  " << plf::lo(a) << ");" << std::endl;
  }
}

TTS_CASE_WITH("mk_const ",
              plf::scalar_real_types,
              tts::randoms(0.0,88.0))
  <typename T>(T const& )
{
  using  mpfr::mpreal;
  auto mlog = [](auto a){ return 1/mpfr::log(a); };
  using plf::double_real_t;
  using plf::triple_real_t;
  {
    print(eve::log(T(10)));
    print(tts::mpfr_exec(mlog, double_real_t<T>(10)));
    print(tts::mpfr_exec(mlog, triple_real_t<T>(10)));

  }
  return 0;
};
