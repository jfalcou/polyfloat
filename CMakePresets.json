{
  "version": 4,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "vendor": {
    "copyright": "Polyfloat - Extended precision floating points: POLYFLOAT Contributors & Maintainers",
    "license": "BSL-1.0",
    "url": "https://github.com/jfalcou/polyfloat"
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "POLYFLOAT_BUILD_TEST": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "unix-base",
      "hidden": true,
      "inherits": ["base"],
      "generator": "Ninja Multi-Config",
      "cacheVariables": { "CMAKE_DEFAULT_BUILD_TYPE": "Debug" }
    },
    {
      "name": "sanitize",
      "hidden": true,
      "cacheVariables": { "POLYFLOAT_ENABLE_SANITIZERS": "ON" }
    },
    {
      "name": "coverage",
      "hidden": true,
      "cacheVariables": { "POLYFLOAT_ENABLE_COVERAGE": "ON", "CMAKE_DEFAULT_BUILD_TYPE": "Debug" }
    },

    { "name": "gcc"        , "inherits": ["unix-base"], "cacheVariables": { "CMAKE_CXX_COMPILER": "g++-15"    , "CMAKE_CXX_FLAGS": "-O0 -DEVE_NO_FORCEINLINE"        } },
    { "name": "gcc-avx2"   , "inherits": ["unix-base"], "cacheVariables": { "CMAKE_CXX_COMPILER": "g++-15"    , "CMAKE_CXX_FLAGS": "-O0 -DEVE_NO_FORCEINLINE -mavx2" } },
    { "name": "clang"      , "inherits": ["unix-base"], "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++-20", "CMAKE_CXX_FLAGS": "-O0 -DEVE_NO_FORCEINLINE"        } },
    { "name": "clang-avx2" , "inherits": ["unix-base"], "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++-20", "CMAKE_CXX_FLAGS": "-O0 -DEVE_NO_FORCEINLINE -mavx2" } },
    { "name": "no-pch"     , "hidden": true, "cacheVariables": { "POLYFLOAT_USE_PCH": "OFF" } },
    { "name": "gcc-no-pch" , "inherits": ["gcc"  , "no-pch"] },

    { "name": "gcc-sanitize"   , "inherits": ["gcc"  , "sanitize"] },
    { "name": "gcc-coverage"   , "inherits": ["gcc"  , "coverage"] },
    { "name": "clang-sanitize" , "inherits": ["clang", "sanitize"] },
    { "name": "clang-coverage" , "inherits": ["clang", "coverage"] },

    {
      "name": "clang-macos",
      "inherits": ["unix-base"],
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-O0 -DEVE_NO_FORCEINLINE -I$env{GITHUB_WORKSPACE} -I$env{GMP_PREFIX}/include -I$env{MPFR_PREFIX}/include",
        "CMAKE_EXE_LINKER_FLAGS": "-L$env{GMP_PREFIX}/lib -L$env{MPFR_PREFIX}/lib"
      }
    },
    {
      "name": "clang-macos-libc++",
      "inherits": ["unix-base"],
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-O0 -DEVE_NO_FORCEINLINE -stdlib=libc++ -I$env{GITHUB_WORKSPACE} -I$env{GMP_PREFIX}/include -I$env{MPFR_PREFIX}/include",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -L$env{GMP_PREFIX}/lib -L$env{MPFR_PREFIX}/lib"
      }
    }
  ],
  "buildPresets": [
    { "name": "base-build", "hidden": true, "targets": ["polyfloat-test"] },
    { "name": "gcc"                , "inherits": "base-build", "configurePreset": "gcc"                },
    { "name": "gcc-avx2"           , "inherits": "base-build", "configurePreset": "gcc-avx2"           },
    { "name": "clang"              , "inherits": "base-build", "configurePreset": "clang"              },
    { "name": "clang-avx2"         , "inherits": "base-build", "configurePreset": "clang-avx2"         },
    { "name": "gcc-no-pch"         , "inherits": "base-build", "configurePreset": "gcc-no-pch"         },
    { "name": "gcc-sanitize"       , "inherits": "base-build", "configurePreset": "gcc-sanitize"       },
    { "name": "gcc-coverage"       , "inherits": "base-build", "configurePreset": "gcc-coverage"       },
    { "name": "clang-sanitize"     , "inherits": "base-build", "configurePreset": "clang-sanitize"     },
    { "name": "clang-coverage"     , "inherits": "base-build", "configurePreset": "clang-coverage"     },
    { "name": "clang-macos"        , "inherits": "base-build", "configurePreset": "clang-macos"        },
    { "name": "clang-macos-libc++" , "inherits": "base-build", "configurePreset": "clang-macos-libc++" }
  ],
  "testPresets": [
    { "name": "base-test", "hidden": true, "output": { "outputOnFailure": true }, "configuration": "Debug" },
    { "name": "gcc"                , "inherits": "base-test", "configurePreset": "gcc"                },
    { "name": "gcc-avx2"           , "inherits": "base-test", "configurePreset": "gcc-avx2"           },
    { "name": "clang"              , "inherits": "base-test", "configurePreset": "clang"              },
    { "name": "clang-avx2"         , "inherits": "base-test", "configurePreset": "clang-avx2"         },
    { "name": "gcc-no-pch"         , "inherits": "base-test", "configurePreset": "gcc-no-pch"         },
    { "name": "gcc-sanitize"       , "inherits": "base-test", "configurePreset": "gcc-sanitize"       },
    { "name": "gcc-coverage"       , "inherits": "base-test", "configurePreset": "gcc-coverage"       },
    { "name": "clang-sanitize"     , "inherits": "base-test", "configurePreset": "clang-sanitize"     },
    { "name": "clang-coverage"     , "inherits": "base-test", "configurePreset": "clang-coverage"     },
    { "name": "clang-macos"        , "inherits": "base-test", "configurePreset": "clang-macos"        },
    { "name": "clang-macos-libc++" , "inherits": "base-test", "configurePreset": "clang-macos-libc++" }
  ]
}
